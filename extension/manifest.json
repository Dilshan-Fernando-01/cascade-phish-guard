{
  "manifest_version": 3,
  "name": "Cascade Phish Guard",
  "version": "0.1.0",
  "description": "Checks web addresses for phishing risk as you browse.",
  "permissions": [
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
